{
  "name": "contexto",
  "description": "Local-first relationship management browser extension for X/Twitter.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "x:lists": "node scripts/x-lists/cli.mjs",
    "dev": "wxt -b chrome",
    "dev:chrome": "wxt -b chrome",
    "dev:vivaldi": "wxt -b chrome",
    "build": "cross-env NODE_ENV=production wxt build -b chrome",
    "zip": "cross-env NODE_ENV=production wxt zip -b chrome",
    "compile": "tsc --noEmit",
    "verify:popup": "node scripts/verify-popup-bundle.mjs",
    "verify:sidebar": "node scripts/verify-sidebar-layout.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare",
    "test:integrity": "vitest run tests/data-integrity.test.ts tests/repositories.test.ts tests/backup-controls.test.tsx tests/grouping-editor-conflicts.test.tsx tests/data-management.test.ts tests/grouping-management.test.ts",
    "check": "npm run lint && npm run compile && npm test && npm run build && npm run verify:popup",
    "verify:integrity": "node scripts/verify-data-integrity.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "@xdevplatform/xdk": "0.6.6",
    "cross-env": "^7.0.3",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
